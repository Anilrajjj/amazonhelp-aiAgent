# Copy this file to .env and fill in ONE provider key.
# .env is gitignored -- never commit a real key.
#
# Do not list LLM_PROVIDER twice: the loader keeps the first value and warns.

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-paste_your_key_here

# Alternatives (set LLM_PROVIDER to match):
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-...

# Optional: override the default model for the selected provider.
# Reported results used openrouter + meta-llama/llama-3.3-70b-instruct.
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
